{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "description": "HelpDesk 360 backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "seed:small": "SEED_SIZE=small ts-node prisma/seed.ts",
    "seed:large": "SEED_SIZE=large ts-node prisma/seed.ts",
    "seed:hostile": "SEED_SIZE=hostile ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "ts-node scripts/perf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.30.1",
    "@prisma/client": "5.22.0",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "node-sql-parser": "4.18.0",
    "pino": "9.5.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "11.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.9.0",
    "@types/supertest": "6.0.2",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
