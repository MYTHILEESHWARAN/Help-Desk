# ─── Database ───────────────────────────────────────────────────────────────
# Full Postgres connection string used by Prisma (via connection pool)
DATABASE_URL=postgresql://helpdesk:helpdesk_password@db:5432/helpdesk?schema=public

# Direct URL for Prisma migrations (bypass PgBouncer if used)
DIRECT_URL=postgresql://helpdesk:helpdesk_password@db:5432/helpdesk?schema=public

# Read-only role for natural-language AI queries
READONLY_DATABASE_URL=postgresql://helpdesk_readonly:readonly_password@db:5432/helpdesk?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 random characters
JWT_SECRET=replace_with_at_least_32_random_characters_here

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Frontend origin for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ─── Seed ────────────────────────────────────────────────────────────────────
# Password assigned to all demo accounts created by the seed script
SEED_PASSWORD=Demo1234!

# ─── AI ──────────────────────────────────────────────────────────────────────
# Anthropic Claude API key — leave blank to run without AI features
ANTHROPIC_API_KEY=

# Claude model to use
AI_MODEL=claude-3-5-haiku-20241022

# Embeddings provider: none | openai | local
# "none" uses Postgres full-text + trigram search only
EMBEDDINGS_PROVIDER=none

# ─── SLA targets (hours) ─────────────────────────────────────────────────────
SLA_URGENT_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72
