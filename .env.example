# HelpDesk 360 — Environment Variables
# Copy this file to .env and fill in your values.
# cp .env.example .env
# docker compose up --build
#
# NOTE: The defaults in docker-compose.yml work out of the box for local dev.
# You only need this file if you want to override them.

# -- Database ------------------------------------------------------------------
# Postgres connection string (host = "db" inside Docker, "localhost" locally)
DATABASE_URL=postgresql://helpdesk:helpdesk_password@db:5432/helpdesk?schema=public

# Direct URL for Prisma migrations (same as DATABASE_URL for single-node setups)
DIRECT_URL=postgresql://helpdesk:helpdesk_password@db:5432/helpdesk?schema=public

# Read-only role used by the NL-query AI feature
READONLY_DATABASE_URL=postgresql://helpdesk_readonly:readonly_password@db:5432/helpdesk?schema=public

# -- Auth ----------------------------------------------------------------------
# JWT signing secret — MUST be at least 32 characters. Change this in production.
JWT_SECRET=helpdesk360_dev_jwt_secret_minimum32chars!!

# -- App -----------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origin for CORS — no trailing slash.
# In Docker: frontend is served from the host at localhost:5173.
FRONTEND_URL=http://localhost:5173

# -- Frontend (Vite proxy target) ----------------------------------------------
# In Docker: Vite proxies /api to the backend SERVICE name.
# Locally:   change to http://localhost:4000
VITE_API_URL=http://backend:4000

# -- Seed ----------------------------------------------------------------------
# Password assigned to all demo accounts. Change in production.
SEED_PASSWORD=Demo1234!

# -- AI (optional) -------------------------------------------------------------
# Leave blank to run without AI features — every AI endpoint degrades gracefully.
ANTHROPIC_API_KEY=

# Claude model name
AI_MODEL=claude-3-5-haiku-20241022

# Embeddings provider: none | openai | local
# "none" uses Postgres full-text + trigram search only (recommended for dev)
EMBEDDINGS_PROVIDER=none

# -- SLA targets (hours) -------------------------------------------------------
SLA_URGENT_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72
